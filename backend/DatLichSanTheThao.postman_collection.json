{
  "info": {
    "name": "Đặt Lịch Sân Thể Thao - API Collection",
    "_postman_id": "datlich-santhethao-2026",
    "description": "Bộ test API đầy đủ cho hệ thống Đặt Lịch Sân Thể Thao.\n\n**Backend:** Node.js + Express + Prisma ORM + MySQL\n**Port:** http://localhost:5000\n**Auth:** JWT Bearer Token\n\n**Hướng dẫn sử dụng:**\n1. Chạy lệnh `npm run dev` trong thư mục `backend/`\n2. Đăng nhập để lấy JWT Token (POST /api/auth/login)\n3. Token tự động lưu vào biến `{{jwt_token}}`\n4. Chạy các request tiếp theo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "san_id",
      "value": "san-cau-long-phu-tho",
      "type": "string"
    },
    {
      "key": "don_dat_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth — Xác Thực",
      "item": [
        {
          "name": "Đăng ký tài khoản mới",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hoTen\": \"Đinh Ngọc Đại\",\n  \"email\": \"dinhdai@gmail.com\",\n  \"soDienThoai\": \"0912345678\",\n  \"matKhau\": \"Abc@123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Đăng nhập (Lấy JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.token) {",
                  "  pm.collectionVariables.set('jwt_token', res.data.token);",
                  "  console.log('✅ JWT Token đã lưu:', res.data.token.substring(0, 30) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taiKhoan\": \"khachhang@gmail.com\",\n  \"matKhau\": \"Abc@123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Đăng nhập Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.token) {",
                  "  pm.collectionVariables.set('jwt_token', res.data.token);",
                  "  console.log('✅ Admin Token đã lưu');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taiKhoan\": \"admin@santhethao.vn\",\n  \"matKhau\": \"Admin@123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Lấy thông tin tài khoản hiện tại (GET /me)",
