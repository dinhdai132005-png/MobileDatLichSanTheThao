// ============================================================
// PRISMA SCHEMA — DỰ ÁN ĐẶT LỊCH SÂN THỂ THAO
// Database: MySQL 8.x (XAMPP / Laragon)
// Chuẩn tiền tệ: Int (VND) — KHÔNG dùng Float/Decimal
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUM ĐỊNH NGHĨA
// ============================================================

enum VaiTro {
  CUSTOMER  // Khách hàng (Mobile App)
  STAFF     // Nhân viên quầy (Ops Web)
  ADMIN     // Quản trị viên (Admin Web)
}

enum CapDoThanhVien {
  THUONG      // Thường: 0–9 lần đặt
  BAC         // Bạc: 10–29 lần đặt
  VANG        // Vàng: 30–59 lần đặt
  KIM_CUONG   // Kim Cương: 60+ lần đặt
}

enum TrangThaiSan {
  HOAT_DONG   // Đang hoạt động bình thường
  BAO_TRI     // Đang bảo trì / tạm dừng
  DONG_CUA    // Đóng cửa vĩnh viễn (soft delete)
}

enum TrangThaiKhungGio {
  TRONG       // Khả dụng
  DA_DAT      // Đã được đặt (confirmed)
  DANG_GIU    // Đang được giữ chỗ tạm thời (5 phút)
  KHOA        // Bị khóa thủ công bởi Admin
}

enum TrangThaiDonDat {
  CHO_XAC_NHAN  // Khách vừa gửi, chờ nhân viên duyệt
  DA_XAC_NHAN   // Nhân viên đã duyệt
  DANG_CHOI     // Khách đã check-in, đang chơi
  HOAN_THANH    // Buổi chơi kết thúc
  DA_HUY        // Bị hủy (bởi khách hoặc admin)
  TU_CHOI       // Bị từ chối bởi nhân viên
}

enum PhuongThucThanhToan {
  TIEN_MAT      // Thu tiền tại sân
  MOMO          // Ví MoMo
  ZALO_PAY      // Ví ZaloPay
  VN_PAY        // Cổng VNPay
  PAY_OS        // Cổng PayOS
  CHUYEN_KHOAN  // Chuyển khoản ngân hàng (VietQR)
}

enum TrangThaiThanhToan {
  CHUA_THANH_TOAN   // Chờ thanh toán
  DA_THANH_TOAN     // Đã thanh toán thành công
  HOAN_TIEN         // Đã hoàn tiền
}

// ============================================================
// MODEL: NGUOI_DUNG — Tài khoản người dùng
// ============================================================
model NguoiDung {
  id              String          @id @default(cuid())
  hoTen           String          @db.VarChar(100)
  email           String          @unique @db.VarChar(150)
  soDienThoai     String          @unique @db.VarChar(15)
  matKhauHash     String          @db.VarChar(255)
  vaiTro          VaiTro          @default(CUSTOMER)
  capDoThanhVien  CapDoThanhVien  @default(THUONG)
  tongLuotDat     Int             @default(0)
  diemTichLuy     Int             @default(0)    // Loyalty points
  avatarUrl       String?         @db.VarChar(500)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  donDatList      DonDat[]
  danhGiaList     DanhGia[]

  @@map("nguoi_dung")
}

// ============================================================
// MODEL: LOAI_SAN — Loại môn thể thao
// ============================================================
model LoaiSan {
  id        String  @id @default(cuid())
  ten       String  @unique @db.VarChar(50) // VD: "Cầu Lông"
  emoji     String  @db.VarChar(10)          // VD: "🏸"
  mauSac    String  @db.VarChar(10)          // VD: "#00C896"
  thuTu     Int     @default(0)              // Thứ tự hiển thị

  // Relations
  sanList   San[]

  @@map("loai_san")
}

// ============================================================
// MODEL: SAN — Sân thể thao
// ============================================================
model San {
  id            String      @id @default(cuid())
  tenSan        String      @db.VarChar(150)
  loaiSanId     String
  diaChi        String      @db.VarChar(300)
  viDo          Float?                        // GPS Latitude
  kinhDo        Float?                        // GPS Longitude
  gioMoCua      String      @db.VarChar(5)   // VD: "06:00"
  gioDongCua    String      @db.VarChar(5)   // VD: "22:00"
  soPhutMoiSlot Int         @default(60)     // 30 hoặc 60 phút/slot
  hotline       String?     @db.VarChar(20)
  moTa          String?     @db.Text
  trangThai     TrangThaiSan @default(HOAT_DONG)

  // Giá — lưu Int (VND)
  giaTienThapDiem   Int     // Giá giờ thấp điểm (VND)
  giaTienCaoDiem    Int     // Giá giờ cao điểm (VND)

  // Tiện ích — JSON array string
  tienIch       Json        @default("[]")   // ["Đèn chiếu sáng", "Bãi đỗ xe", ...]

  // Thống kê (denormalized để tăng tốc query)
  diemDanhGia   Float       @default(0.0)
  soLuotDanhGia Int         @default(0)
  soLuotDat     Int         @default(0)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  loaiSan       LoaiSan     @relation(fields: [loaiSanId], references: [id])
  anhSanList    AnhSan[]
  khungGioCauHinh KhungGioCauHinh[]
  donDatList    DonDat[]
  danhGiaList   DanhGia[]
  khuyenMaiSan  KhuyenMaiSan[]

  @@index([loaiSanId])
  @@index([trangThai])
  @@map("san")
}

// ============================================================
// MODEL: ANH_SAN — Ảnh thực tế của sân
// ============================================================
model AnhSan {
  id        String  @id @default(cuid())
  sanId     String
  url       String  @db.VarChar(500)
  moTa      String? @db.VarChar(200)
  thuTu     Int     @default(0)

  san       San     @relation(fields: [sanId], references: [id], onDelete: Cascade)

  @@index([sanId])
  @@map("anh_san")
}

// ============================================================
// MODEL: KHUNG_GIO_CAU_HINH — Cấu hình Peak Hours
// Định nghĩa khung giờ cao điểm theo ngày trong tuần
// ============================================================
model KhungGioCauHinh {
  id          String  @id @default(cuid())
  sanId       String
  // 0=CN, 1=T2, 2=T3, 3=T4, 4=T5, 5=T6, 6=T7
  // -1 = áp dụng tất cả các ngày
  ngayTrongTuan Int
  gioTu       String  @db.VarChar(5)  // VD: "17:00"
  gioDen      String  @db.VarChar(5)  // VD: "21:00"
  laCaoDiem   Boolean @default(true)

  san         San     @relation(fields: [sanId], references: [id], onDelete: Cascade)

  @@index([sanId])
  @@map("khung_gio_cau_hinh")
}

// ============================================================
// MODEL: DON_DAT — Đơn đặt sân (Booking)
// ============================================================
model DonDat {
  id                  String              @id @default(cuid())
  maDon               String              @unique @default(cuid()) // Mã QR hiển thị cho khách
  sanId               String
  nguoiDungId         String?             // null nếu đặt tại quầy không có tài khoản
  
  // Thông tin liên hệ (lưu snapshot, không phụ thuộc bảng user)
  tenKhach            String              @db.VarChar(100)
  soDienThoaiKhach    String              @db.VarChar(15)
  ghiChu              String?             @db.Text

  // Thời gian đặt
  ngayDat             DateTime            // Ngày chơi (date only)
  gioKhoa             String              @db.VarChar(5)   // "08:00" — giờ bắt đầu
  soGioThue           Float               // 1.0, 1.5, 2.0, 3.0
  gioKetThuc          String              @db.VarChar(5)   // "09:00" — tự tính

  // Tài chính — lưu Int (VND)
  donGia              Int                 // Đơn giá tại thời điểm đặt (snapshot)
  tongTienSan         Int                 // Tiền sân
  tongTienFnB         Int                 @default(0)  // Tiền đồ uống
  tongTienDungCu      Int                 @default(0)  // Tiền thuê dụng cụ
  giamGia             Int                 @default(0)  // Số tiền được giảm
  tongCong            Int                 // Tổng phải trả

  // Trạng thái
  trangThai           TrangThaiDonDat     @default(CHO_XAC_NHAN)
  trangThaiThanhToan  TrangThaiThanhToan  @default(CHUA_THANH_TOAN)
  phuongThucThanhToan PhuongThucThanhToan @default(TIEN_MAT)

  // Các mốc thời gian
  thoiGianGiuCho      DateTime?           // Deadline 5 phút giữ slot
  thoiGianXacNhan     DateTime?
  thoiGianCheckIn     DateTime?
  thoiGianKetThuc     DateTime?
  thoiGianHuy         DateTime?
  lyDoHuy             String?             @db.VarChar(500)

  // Audit
  taoBoiNhanVienId    String?             // null nếu tự đặt online
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  // Relations
  san                 San                 @relation(fields: [sanId], references: [id])
  nguoiDung           NguoiDung?          @relation(fields: [nguoiDungId], references: [id])
  chiTietFnB          ChiTietFnB[]
  chiTietDungCu       ChiTietDungCu[]
  danhGia             DanhGia?
  voucherDonDat       VoucherDonDat?

  @@index([sanId])
  @@index([nguoiDungId])
  @@index([ngayDat, gioKhoa])             // Index chính cho chống double-booking
  @@index([trangThai])
  @@index([thoiGianGiuCho])
  @@map("don_dat")
}

// ============================================================
// MODEL: DO_UONG — Sản phẩm đồ uống bán tại sân
// ============================================================
model DoUong {
  id          String  @id @default(cuid())
  ten         String  @db.VarChar(100)
  danhMuc     String  @db.VarChar(50)  // "Nước ngọt", "Thể thao", "Cà phê"...
  giaBan      Int                       // Giá bán (VND Int)
  giaNhap     Int     @default(0)       // Giá vốn (VND Int)
  tonKho      Int     @default(0)
  nguongCanhBao Int   @default(5)       // Cảnh báo khi tồn kho < ngưỡng này
  anhUrl      String? @db.VarChar(500)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chiTietFnBList ChiTietFnB[]

  @@map("do_uong")
}

// ============================================================
// MODEL: CHI_TIET_FNB — Chi tiết đồ uống trong đơn đặt
// ============================================================
model ChiTietFnB {
  id        String  @id @default(cuid())
  donDatId  String
  doUongId  String
  soLuong   Int
  donGia    Int     // Snapshot giá tại thời điểm đặt
  thanhTien Int     // soLuong * donGia

  donDat    DonDat  @relation(fields: [donDatId], references: [id], onDelete: Cascade)
  doUong    DoUong  @relation(fields: [doUongId], references: [id])

  @@index([donDatId])
  @@map("chi_tiet_fnb")
}

// ============================================================
// MODEL: DUNG_CU — Dụng cụ cho thuê
// ============================================================
model DungCu {
  id              String  @id @default(cuid())
  maDungCu        String  @unique @db.VarChar(50) // Mã QR in lên dụng cụ
  ten             String  @db.VarChar(100) // "Vợt cầu lông", "Bóng đá"...
  loai            String  @db.VarChar(50)
  phiThuePerBuoi  Int                      // Phí thuê/buổi (VND Int)
  phiBoiThuong    Int                      // Phí bồi thường nếu hỏng
  trangThai       String  @default("SAN_SANG") // SAN_SANG, DANG_CHO_MUON, HONG, BAO_TRI
  ghiChu          String? @db.VarChar(300)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chiTietDungCuList ChiTietDungCu[]

  @@map("dung_cu")
}

// ============================================================
// MODEL: CHI_TIET_DUNG_CU — Chi tiết dụng cụ trong đơn đặt
// ============================================================
model ChiTietDungCu {
  id          String  @id @default(cuid())
  donDatId    String
  dungCuId    String
  soLuong     Int
  phiThue     Int     // Snapshot phí thuê
  tinhTrangTra String? // Trạng thái khi trả: "TOT", "BI_HONG"
  phiBoiThuong Int    @default(0)

  donDat      DonDat  @relation(fields: [donDatId], references: [id], onDelete: Cascade)
  dungCu      DungCu  @relation(fields: [dungCuId], references: [id])

  @@index([donDatId])
  @@map("chi_tiet_dung_cu")
}

// ============================================================
// MODEL: DANH_GIA — Đánh giá & chấm sao
// ============================================================
model DanhGia {
  id          String    @id @default(cuid())
  donDatId    String    @unique
  sanId       String
  nguoiDungId String
  soSao       Int       // 1–5
  noiDung     String?   @db.Text
  anhUrl      String?   @db.VarChar(500)
  phanHoiAdmin String?  @db.Text  // Phản hồi từ Admin/quản lý
  isHidden    Boolean   @default(false) // Ẩn nếu vi phạm chính sách
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  donDat      DonDat    @relation(fields: [donDatId], references: [id])
  san         San       @relation(fields: [sanId], references: [id])
  nguoiDung   NguoiDung @relation(fields: [nguoiDungId], references: [id])

  @@index([sanId])
  @@index([nguoiDungId])
  @@map("danh_gia")
}

// ============================================================
// MODEL: VOUCHER — Mã giảm giá
// ============================================================
model Voucher {
  id                String    @id @default(cuid())
  maVoucher         String    @unique @db.VarChar(30)
  ten               String    @db.VarChar(100)
  loai              String    @db.VarChar(20) // "FIXED" | "PERCENT"
  giaTriGiam        Int       // VND nếu FIXED, % nếu PERCENT
  giaTriDonToiThieu Int       @default(0)     // Đơn tối thiểu để áp
  soLanToiDa        Int       @default(1)
  soLanDaSuDung     Int       @default(0)
  ngayBatDau        DateTime
  ngayKetThuc       DateTime
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())

  voucherDonDat     VoucherDonDat[]

  @@map("voucher")
}

// ============================================================
// MODEL: VOUCHER_DON_DAT — Liên kết voucher với đơn đặt
// ============================================================
model VoucherDonDat {
  id          String  @id @default(cuid())
  donDatId    String  @unique
  voucherId   String
  soTienGiam  Int     // Số tiền thực tế được giảm

  donDat      DonDat  @relation(fields: [donDatId], references: [id])
  voucher     Voucher @relation(fields: [voucherId], references: [id])

  @@map("voucher_don_dat")
}

// ============================================================
// MODEL: KHUYEN_MAI_SAN — Khuyến mãi Flash Sale theo sân
// ============================================================
model KhuyenMaiSan {
  id            String    @id @default(cuid())
  sanId         String
  ten           String    @db.VarChar(100)
  phanTramGiam  Int       // %
  gioTu         String    @db.VarChar(5)
  gioDen        String    @db.VarChar(5)
  ngayBatDau    DateTime
  ngayKetThuc   DateTime
  isActive      Boolean   @default(true)

  san           San       @relation(fields: [sanId], references: [id])

  @@index([sanId])
  @@map("khuyen_mai_san")
}
