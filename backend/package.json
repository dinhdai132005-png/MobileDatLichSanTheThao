{
  "name": "dat-lich-san-the-thao-backend",
  "version": "1.2.0",
  "description": "Backend API (Node.js + Express + TypeScript + MySQL) cho hệ thống quản lý và đặt sân thể thao",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:reset": "tsx scripts/khoitaocsdl.ts",
    "seed:admin": "tsx scripts/taoadmin.ts",
    "test": "jest --runInBand"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.14.0",
    "zod": "^4.0.0"
  }
